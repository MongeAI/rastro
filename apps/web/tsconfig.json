{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@rastro/core": ["../../packages/core/src/index.ts"],
      "@rastro/graph": ["../../packages/graph/src/index.ts"]
    }
  },
  "include": ["src"]
}
