{
  "name": "teia-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Teia — transforma repositórios JavaScript/TypeScript em mapas navegáveis de código.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/graph",
    "packages/analyzer",
    "apps/web",
    "apps/cli"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/graph packages/analyzer apps/cli && npm run build -w @teia/web && node scripts/copy-web.mjs",
    "dev:web": "npm run dev -w @teia/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/core packages/graph packages/analyzer apps/cli && npm run typecheck -w @teia/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "teia": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
