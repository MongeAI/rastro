{
  "name": "rastro-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Rastro — transforma repositórios JavaScript/TypeScript em mapas navegáveis de código.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/graph",
    "packages/analyzer",
    "apps/web",
    "apps/cli"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/graph packages/analyzer apps/cli && npm run build -w @rastro/web && node scripts/copy-web.mjs && node scripts/bundle-cli.mjs",
    "dev:web": "npm run dev -w @rastro/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bench": "node scripts/bench.mjs",
    "typecheck": "tsc -b packages/core packages/graph packages/analyzer apps/cli && npm run typecheck -w @rastro/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "rastro": "node apps/cli/bin/rastro.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "25.12.0",
    "rolldown": "^1.2.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MongeAI/rastro.git"
  },
  "homepage": "https://github.com/MongeAI/rastro#readme",
  "bugs": {
    "url": "https://github.com/MongeAI/rastro/issues"
  },
  "author": "MongeAI"
}
